<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>app.truearena</groupId>
    <artifactId>truearena-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>truearena-backend</name>
    <description>TrueArena reactive backend (Architecture §2).</description>

    <modules>
        <module>ta-engine</module>
        <module>ta-game-truearena</module>
        <module>ta-game-wordbluff</module>
        <module>ta-game-draughts</module>
        <module>ta-game-goosi</module>
        <module>ta-game-whot</module>
        <module>ta-game-ludo</module>
        <module>ta-persistence</module>
        <module>ta-room</module>
        <module>ta-ws</module>
        <module>ta-voice</module>
        <module>ta-api</module>
        <module>ta-app</module>
        <module>ta-contract-tests</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <testcontainers.version>1.20.3</testcontainers.version>
        <archunit.version>1.3.0</archunit.version>
        <blockhound.version>1.0.10.RELEASE</blockhound.version>
        <jjwt.version>0.12.6</jjwt.version>
        <livekit.version>0.8.1</livekit.version>
        <springdoc.version>2.6.0</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- internal modules -->
            <dependency>
                <groupId>app.truearena</groupId>
                <artifactId>ta-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>app.truearena</groupId>
                <artifactId>ta-game-truearena</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>app.truearena</groupId>
                <artifactId>ta-game-wordbluff</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>app.truearena</groupId>
                <artifactId>ta-game-draughts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>app.truearena</groupId>
                <artifactId>ta-game-goosi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>app.truearena</groupId>
                <artifactId>ta-game-whot</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>app.truearena</groupId>
                <artifactId>ta-game-ludo</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>app.truearena</groupId>
                <artifactId>ta-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>app.truearena</groupId>
                <artifactId>ta-room</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>app.truearena</groupId>
                <artifactId>ta-ws</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>app.truearena</groupId>
                <artifactId>ta-voice</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>app.truearena</groupId>
                <artifactId>ta-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>app.truearena</groupId>
                <artifactId>ta-app</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- third-party not managed by spring-boot -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>io.projectreactor.tools</groupId>
                <artifactId>blockhound</artifactId>
                <version>${blockhound.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.livekit</groupId>
                <artifactId>livekit-server</artifactId>
                <version>${livekit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- every module gets the test toolkit -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- unit tests: everything except @Tag("integration") -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>integration</excludedGroups>
                </configuration>
            </plugin>
            <!-- integration tests: only @Tag("integration"), on `verify`; skip with -DskipITs -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <groups>integration</groups>
                </configuration>
                <executions>
                    <execution>
                        <id>integration</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
