<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>app.truearena</groupId>
        <artifactId>truearena-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ta-app</artifactId>
    <description>Spring Boot entrypoint: wires every module, actuator, Flyway.</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <dependency>
            <groupId>app.truearena</groupId>
            <artifactId>ta-api</artifactId>
        </dependency>
        <dependency>
            <groupId>app.truearena</groupId>
            <artifactId>ta-ws</artifactId>
        </dependency>
        <dependency>
            <groupId>app.truearena</groupId>
            <artifactId>ta-voice</artifactId>
        </dependency>
        <dependency>
            <groupId>app.truearena</groupId>
            <artifactId>ta-room</artifactId>
        </dependency>
        <dependency>
            <groupId>app.truearena</groupId>
            <artifactId>ta-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>app.truearena</groupId>
            <artifactId>ta-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>app.truearena</groupId>
            <artifactId>ta-game-truearena</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>truearena-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>app.truearena.TrueArenaApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
